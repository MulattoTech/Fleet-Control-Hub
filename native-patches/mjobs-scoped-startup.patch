+test('scoped Startup validates project and revision and carries them into the bootstrap context', async t => {
+  const f=fixture(t), controller=f.make(), revision='a'.repeat(64);
+  assert.throws(()=>controller.start(request('scope-bad-01',{expectedProjectId:'babytracker',expectedManifestRevision:revision})),/MJobs project/);
+  assert.throws(()=>controller.start(request('scope-bad-02',{expectedProjectId:'mjobs-luna'})),/exact manifest revision/);
+  f.deps.bootstrap=async ctx=>{
+    assert.equal(ctx.expectedProjectId,'mjobs-luna');
+    assert.equal(ctx.expectedManifestRevision,revision);
+    return {ok:false,targetCount:0,reason:'Manifest changed'};
+  };
+  controller.start(request('scope-valid-01',{expectedProjectId:'mjobs-luna',expectedManifestRevision:revision}));
+  const result=await controller.waitForIdle();
+  assert.equal(result.phase,'failed');
+  assert.equal(result.options.expectedProjectId,'mjobs-luna');
+  assert.equal(result.options.expectedManifestRevision,revision);
+  assert.deepEqual(f.events,[]);
+});
+
