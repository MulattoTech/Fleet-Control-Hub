+test('scoped Startup rejects a cross-project or changed manifest before restore submission',async t=>{
+  const f=fixture(t);
+  for(const session of f.state.saved.sessions)session.projectId='mjobs-luna';
+  const adapter=f.make(),revision=adapter.manifest().revision;
+  const scoped=f.context({expectedProjectId:'mjobs-luna',expectedManifestRevision:revision,bootstrap:{manifestRevision:revision,branchAdoptionsRevision:null}});
+  f.state.saved.sessions.push({id:'babytracker-1',projectId:'babytracker',kind:'orchestrator',harness:'codex',activity:'idle'});
+  const preview=await adapter.bootstrap(scoped);
+  assert.equal(preview.ok,false);assert.match(preview.reason,/includes another project/);
+  assert.deepEqual(f.state.effects,[]);
+  f.protect();
+  scoped.guardReceipt={token:configRevision(f.state.config)};
+  await assert.rejects(adapter.restoreStart(scoped),/includes another project/);
+  assert.equal(f.state.effects.some(x=>x.op==='restore.start'),false);
+  f.state.saved.sessions.pop();
+  f.state.saved.sessions[1].id='mjobs-changed-worker';
+  await assert.rejects(adapter.restoreStart(scoped),/manifest changed/);
+  assert.equal(f.state.effects.some(x=>x.op==='restore.start'),false);
+});
