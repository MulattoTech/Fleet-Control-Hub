+test('MJobs project preview derives an isolated roster without changing BabyTracker entries',t=>{
+  const f=fixture(t);
+  for(const session of f.state.saved.sessions)session.projectId='mjobs-luna';
+  f.state.saved.sessions.push({id:'babytracker-1',projectId:'babytracker',kind:'orchestrator',harness:'codex',activity:'idle'});
+  const before=clone(f.state.saved),adapter=f.make();
+  const preview=adapter.projectPreview('mjobs-luna');
+  assert.equal(preview.preservedCount,3);
+  assert.equal(preview.targetCount,3);
+  assert.deepEqual(preview.primaryIds,['mjobs-primary']);
+  assert.equal(preview.scopedStartSupported,false);
+  assert.match(preview.manifestRevision,/^[a-f0-9]{64}$/);
+  assert.notEqual(preview.manifestRevision,preview.sourceManifestRevision);
+  assert.deepEqual(f.state.saved,before);
+  assert.deepEqual(f.state.effects,[]);
+});
