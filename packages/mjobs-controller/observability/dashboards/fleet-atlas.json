  "panels": [
    {
      "id": 1,
      "title": "FLEET ATLAS · Native telemetry, not simulated productivity",
      "description": "",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "fleet-native"
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8bbcff",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "## Fleet workspace\n[← Fleet Overview](https://fleet.m-techlabs.com/) · [Fleet Atlas](https://m-techlabs.com/mission-control/analytics/) · [Mission Control](https://m-techlabs.com/mission-control/)\n\n**On this PC:** [Local Overview](http://127.0.0.1:4320/) · [Local Atlas](http://127.0.0.1:20800/mission-control/analytics/) · [Local Mission Control](http://127.0.0.1:18726/)\n\n**Executing** means a native active turn. Reserved agents are **on-call**, not busy. ETA values are conditional. Token use is not acceptance. Missing per-turn attribution remains unavailable."
      }
    },
    {
      "id": 20,
      "title": "Source health · last check",
      "description": "No data means the source-health receipt is stale or invalid, not zero activity. This check is separate from the last successful observation. An offline source or identity mismatch never re-dates old counts. Data panels expire after 90 seconds.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 5
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "fleet-native"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "fleet-native"
          },
          "type": "json",
          "source": "url",
          "url": "http://fleet-analytics-data:8080/collector-status.json",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "parser": "backend",
          "format": "table",
          "root_selector": "($age := $millis() - $toMillis(checkedAt); $sampleAge := lastSuccessAt ? $millis() - $toMillis(lastSuccessAt) : 90001; $fresh := schemaVersion = 1 and staleAfterSeconds = 90 and $type(available) = 'boolean' and $age >= -10000 and $age <= 90000; $live := $fresh and available = true and reasonCode = 'OK' and $sampleAge >= -10000 and $sampleAge <= 90000; $fresh and (available = false or $live) ? [$] : [])",
          "columns": [
            {
              "selector": "available",
              "text": "Source status",
              "type": "string"
            },
            {
              "selector": "reasonCode",
              "text": "Reason code",
              "type": "string"
            },
            {
              "selector": "message",
              "text": "Reason",
              "type": "string"
            },
            {
              "selector": "checkedAt",
              "text": "Source checked",
              "type": "timestamp"
            },
            {
              "selector": "lastSuccessAt",
              "text": "Last successful observation",
              "type": "timestamp"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8bbcff",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Source status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "true": {
                        "text": "LIVE",
                        "color": "#91d6b7"
                      },
                      "false": {
                        "text": "SOURCE UNAVAILABLE",
                        "color": "#edc67a"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      }
    },
